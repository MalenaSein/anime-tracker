# ============================================
# FRONTEND - Variables de entorno
# Copiá este archivo a .env y completá los valores.
# React solo expone variables que empiezan con REACT_APP_.
# ============================================

# URL del backend. Debe incluir /api al final.
REACT_APP_API_URL=http://localhost:3001/api

# Firebase Web SDK (Firebase Console → Configuración del proyecto → Tus apps)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=