# ============================================
# BACKEND - Variables de entorno
# Copiá este archivo a .env y completá los valores.
# ============================================

# Servidor
PORT=3001

# Base de datos MySQL (Aiven)
DB_HOST=tu-host.aivencloud.com
DB_PORT=25060
DB_USER=avnadmin
DB_PASSWORD=tu-password
DB_NAME=defaultdb

# SSL de la base de datos.
# false = compatible con CAs propias (por defecto).
# true  = exige validación estricta del certificado.
DB_SSL_STRICT=false

# Secreto para los JWT legacy (usuarios previos a Firebase).
# Opcional: si falta, solo se deshabilita la autenticación legacy.
# Generá uno con: openssl rand -hex 32
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma.
# En producción agregá el dominio exacto del frontend.
CORS_ORIGIN=http://localhost:3000,https://malenasein.github.io

# Firebase Admin (producción / Render)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa en desarrollo: colocar firebase-service-account.json en backend/
# (está ignorado por git).

# Web Push (notificaciones)
# Generá las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu@email.com